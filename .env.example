# Xplainable MCP Server Configuration
# Copy this file to .env and fill in your values

# Required: Your Xplainable API key (create one at https://platform.xplainable.io)
XPLAINABLE_API_KEY=your-api-key-here

# Optional: Xplainable API hostname (defaults to production).
# Set BOTH variables to the same value if you override the host.
XPLAINABLE_HOST=https://platform.xplainable.io
XPLAINABLE_HOSTNAME=https://platform.xplainable.io

# Optional: Organization / team binding (needed if your API key is not
# bound to a team)
XPLAINABLE_ORG_ID=
XPLAINABLE_TEAM_ID=

# Optional tool-surface tiers (accepted values: 1, true, yes).
# Default (both unset): direct mode — curated iterate-loop tools (33).
# GUIDED adds the hands-off workflow trio (36). ADVANCED exposes the
# full registry (~107) and wins if both are set.
XPLAINABLE_GUIDED_TOOLS=
XPLAINABLE_ADVANCED_TOOLS=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
